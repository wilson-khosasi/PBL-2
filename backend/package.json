{
   "name": "himti-backend-boilerplate",
   "version": "1.0.0",
   "description": "HIMTI backend boilerplate built with Express, TypeScript, Prisma, and PostgreSQL.",
   "main": "dist/index.js",
   "scripts": {
      "dev": "tsx watch src/index.ts",
      "build": "tsc && tsc-alias",
      "start": "node dist/index.js",
      "prisma:migrate": "prisma migrate dev",
      "prisma:generate": "prisma generate",
      "prisma:studio": "prisma studio",
      "lint": "eslint src --ext .ts",
      "format": "prettier --write ."
   },
   "imports": {
      "@/*": "./dist/*"
   },
   "keywords": [
      "express",
      "typescript",
      "prisma",
      "postgresql",
      "boilerplate",
      "himti"
   ],
   "author": "HIMTI Web Development Training",
   "license": "MIT",
   "type": "module",
   "dependencies": {
      "@asteasolutions/zod-to-openapi": "^7.3.4",
      "@prisma/client": "^6.11.1",
      "@scalar/express-api-reference": "^0.10.6",
      "bcrypt": "^6.0.0",
      "cors": "^2.8.5",
      "dotenv": "^17.0.1",
      "express": "^5.1.0",
      "jsonwebtoken": "^9.0.3",
      "zod": "^3.25.67"
   },
   "devDependencies": {
      "@eslint/js": "^9.30.1",
      "@types/bcrypt": "^6.0.0",
      "@types/cors": "^2.8.19",
      "@types/express": "^5.0.3",
      "@types/jsonwebtoken": "^9.0.10",
      "@types/node": "^24.0.10",
      "eslint": "^9.30.1",
      "prettier": "^3.6.2",
      "prisma": "^6.11.1",
      "tsc-alias": "^1.8.16",
      "tsx": "^4.20.3",
      "typescript": "^5.8.3",
      "typescript-eslint": "^8.35.1"
   }
}
